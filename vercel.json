{
    "version": 2,
    "framework": null,
    "functions": {
        "api/index.php": { "runtime": "vercel-php@0.7.4" }
    },
    "routes": [
        { "src": "/favicon.ico", "dest": "/public/favicon.ico" },
        { "src": "/favicon.png", "dest": "/public/favicon.png" },
        { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
        { "src": "/build/(.*)", "dest": "/public/build/" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "public": true,
    "buildCommand": "vite build",
    "outputDirectory": "public",
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "true",
        "APP_URL": "https://siakad-coba.vercel.app",
        "APP_KEY": "base64:m2d7rGQ9BtpqNmCDJDp01KElX2oUIPJLlPfC1KNTDoo=",
        "CACHE_DRIVER": "array",
        "LOG_CHANNEL": "stderr",
        "SESSION_DRIVER": "array",
        "QUEUE_CONNECTION": "sync",
        "APP_MAINTENANCE_DRIVER": "file",
        "CACHE_STORE": "file"
    }
    
}